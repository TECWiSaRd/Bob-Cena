# Copy to .env and fill in. Keep this file private (install.sh sets chmod 600).
ANTHROPIC_API_KEY=sk-ant-...

# Optional password for the camera stream; then open http://<pi-ip>:8080/?token=<this>
# BOB_STREAM_TOKEN=pick-something-long

# Robot-to-robot radio: a long random text shared by both robots, and ONLY them.
# Generate one with:  python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# BOB_RADIO_SECRET=

# Home Assistant (optional): a long-lived access token, from your HA profile page. Use a separate HA user for Bob.
# HA_TOKEN=
